rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // 치팅 방지: 게임 데이터 쓰기는 스태프키로 인증된 멤버만.
    function memberDoc(g) {
      return /databases/$(db)/documents/games/$(g)/members/$(request.auth.uid);
    }
    function isStaff(g) {
      return request.auth != null && exists(memberDoc(g))
        && get(memberDoc(g)).data.role in ['staff', 'hq'];
    }
    function staffKey(g) {
      return get(/databases/$(db)/documents/games/$(g)/private/keys).data.staffKey;
    }
    function ownerUid(g) {
      return get(/databases/$(db)/documents/games/$(g)).data.ownerUid;
    }

    match /games/{g} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isStaff(g);

      match /private/{d} { // 스태프키 보관 — HQ만 열람
        allow read: if request.auth != null && exists(memberDoc(g))
          && get(memberDoc(g)).data.role == 'hq';
        allow create: if request.auth != null && ownerUid(g) == request.auth.uid;
      }

      match /members/{uid} { // 입장 기록. 스태프 승격은 스태프키 일치할 때만
        allow read: if isStaff(g) || (request.auth != null && request.auth.uid == uid);
        allow create, update: if request.auth != null && request.auth.uid == uid && (
          request.resource.data.role == 'player'
          || (request.resource.data.role == 'staff'
              && request.resource.data.key == staffKey(g))
          || (request.resource.data.role == 'hq'
              && ownerUid(g) == request.auth.uid)
        );
      }

      match /teams/{t} {
        allow read: if request.auth != null;
        // 스태프는 전체, 참가자는 자기 팀 문서만 (주사위·구매·자기버프)
        // 상대 팀을 건드리는 공격 아이템은 여전히 스태프 전용
        allow write: if isStaff(g)
          || (request.auth != null && exists(memberDoc(g))
              && get(memberDoc(g)).data.teamId == t);
      }
      match /log/{l} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && exists(memberDoc(g)); // 멤버면 기록 가능
      }
      match /tokens/{t} { // 푸시 토큰: 등록은 본인, 열람은 멤버 (참가자 구매 알림 발송용)
        allow read: if request.auth != null && exists(memberDoc(g));
        allow create, update: if request.auth != null;
      }
    }
  }
}
